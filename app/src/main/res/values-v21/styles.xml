<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- M3 alert dialogs. Geometry and colours are applied at runtime by M3Dialogs (scheme roles are dynamic). -->
  <style name="M3DialogTheme" parent="@android:style/Theme.Material.Light.Dialog.Alert">
    <item name="android:textColorLink">#ff039be5</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:buttonBarButtonStyle">@style/M3DialogButton</item>
  </style>
  <style name="M3DialogThemeDark" parent="@android:style/Theme.Material.Dialog.Alert">
    <item name="android:textColorLink">#ff039be5</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:buttonBarButtonStyle">@style/M3DialogButton</item>
  </style>
  <style name="M3DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">14sp</item>
    <item name="android:minWidth">48dp</item>
    <item name="android:minHeight">40dp</item>
    <item name="android:paddingStart">12dp</item>
    <item name="android:paddingEnd">12dp</item>
  </style>
</resources>
