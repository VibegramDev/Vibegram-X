# Monet (White): light scheme. Syntax and rules: base.monet.

include: base

# Surfaces: rows are pure white (surfaceContainerLowest, tone 100); the page is the M3 surfaceContainer role
# (tone ~94), so segmented settings groups stand out without shadows. Pressed = onSurface state layer, opaque.
filling: surfaceContainerLowest
overlayFilling: surfaceContainerLowest
fillingPressed: mix(surfaceContainerLowest,onSurface,10)
background: surfaceContainer

# Chat: plain (monochrome) background, incoming bubbles are white rows on it
chatBackground: surfaceContainer
bubbleIn_background: surfaceContainerLowest
