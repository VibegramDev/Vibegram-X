# Monet (Black): the dark scheme with a true-black (AMOLED) surface. Syntax and rules: base.monet.
#
# MonetPalette makes the surface role #000 in this scheme, so every color of Monet (Dark) that uses surface
# (lists, app bars, pages, chat) is true black; containers stay tonal.

include: dark

# The keyboard panel and the floating layers lean one container lower, closer to black
chatKeyboard: surface
overlayFilling: surfaceContainer
bubbleIn_background: surfaceContainer
