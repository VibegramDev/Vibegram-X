# Monet (Dark): dark scheme. Syntax and rules: base.monet.

include: base

# Surfaces: lists, app bars, settings pages and the chat are the M3 surface role; floating layers are
# surfaceContainerHigh. Pressed = onSurface state layer, opaque.
filling: surface
overlayFilling: surfaceContainerHigh
fillingPressed: mix(surface,onSurface,10)
background: surface

# Chat: plain (monochrome) background, incoming bubbles are a raised container
chatBackground: surface
bubbleIn_background: surfaceContainerHigh
